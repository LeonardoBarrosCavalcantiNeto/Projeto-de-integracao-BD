# Copie este arquivo para .env e preencha PGPASSWORD localmente.
# Nunca publique o arquivo .env no GitHub.
PGHOST=localhost
PGPORT=5432
PGDATABASE=vra_dw_2019
PGUSER=postgres
PGPASSWORD=COLOQUE_SUA_SENHA_AQUI
PGSCHEMA=dw_etl
# DATABASE_URL pode ser usada no lugar das variáveis PG* (opcional).
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/vra_dw_2019

# Integração compartilhada (scripts/integrar_anac.py): exporte PG* no shell.
# PGDATABASE=anac_dw
# A CLI de integração usa libpq/psql; não carrega este arquivo automaticamente.
