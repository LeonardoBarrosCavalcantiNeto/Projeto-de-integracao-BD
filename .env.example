# Modelo para executar a carga dos ETLs individuais via Python.
# Copie para .env, ajuste o banco de teste e preencha a senha localmente.
# Os valores abaixo são exemplos. Mantenha .env fora do Git.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=vra_dw_2019
PGUSER=anac_avaliacao
PGPASSWORD=

# ETL 2019 usa dw_etl por padrão. Para ETL 2020, use etl_2020 ou etl_2020_<sufixo>.
# O ETL individual de 2021 configura seu schema pelo parâmetro de carga.
# PGSCHEMA=dw_etl

# Alternativa aos parâmetros de conexão PG*. Preencha apenas no ambiente local.
# DATABASE_URL=postgresql+psycopg://usuario@127.0.0.1:5432/vra_dw_2019
# Opção do ETL 2019 para conexão sem DATABASE_URL.
# PGSSLMODE=require

# Para os bundles finais, configure PG* no shell e use o guia multiplataforma.
# psql lê o ambiente do shell e a configuração libpq.
# PGCLIENTENCODING=UTF8
